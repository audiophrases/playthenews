<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <Button android:id="@+id/collapse_player" style="@style/TopAction"
            android:text="@string/expand_player" />
        <Button android:id="@+id/theme_toggle" style="@style/TopAction"
            android:layout_weight="1.2" android:text="@string/day_mode" />
        <TextView android:id="@+id/language" style="@style/TopAction"
            android:text="@string/language" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/category_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:scrollbars="none">
        <LinearLayout android:id="@+id/categories"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ImageView
        android:id="@+id/art"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_art"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/secondary"
        android:textSize="15sp" />

    <LinearLayout android:id="@+id/player_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <SeekBar
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="#FF5F6368"
        android:thumbTint="@color/accent"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">
        <TextView
            android:id="@+id/elapsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:text="0:00" />
        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:text="0:00" />
    </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton android:id="@+id/prev" style="@style/PlayerControlButton"
            android:src="@drawable/ic_prev" android:contentDescription="@string/previous" />
        <ImageButton android:id="@+id/rewind" style="@style/PlayerControlButton"
            android:src="@drawable/ic_rewind" android:contentDescription="@string/rewind" />
        <ImageButton
            android:id="@+id/play_pause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/bg_play"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/play_pause" />
        <ImageButton android:id="@+id/forward" style="@style/PlayerControlButton"
            android:src="@drawable/ic_forward" android:contentDescription="@string/forward" />
        <ImageButton android:id="@+id/next" style="@style/PlayerControlButton"
            android:src="@drawable/ic_next" android:contentDescription="@string/next" />
        <ImageButton android:id="@+id/stop" style="@style/PlayerControlButton"
            android:src="@drawable/ic_stop" android:contentDescription="@string/stop" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:textColor="@color/accent"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/queue_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:text="@string/up_next" />
        <TextView
            android:id="@+id/edit_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:text="@string/edit_list" />
    </LinearLayout>

    <ListView
        android:id="@+id/queue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="@null" />
</LinearLayout>
</FrameLayout>
