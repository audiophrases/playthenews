<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PlayerTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FF8AB4F8</item>
        <item name="android:statusBarColor">#FF121214</item>
        <item name="android:navigationBarColor">#FF121214</item>
        <item name="android:windowBackground">@android:color/black</item>
