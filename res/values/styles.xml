<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PlayerTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FF8AB4F8</item>
        <item name="android:statusBarColor">#FF121214</item>
        <item name="android:navigationBarColor">#FF121214</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="ControlButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="OrderChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_toggle</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
